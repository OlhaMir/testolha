fig, ax = plt.subplots(subplot_kw={"projection": "3d"})
ax.plot_surface(X, Y, Z, vmin=Z.min() * 2, cmap=cm.Blues)

ax.set(xticklabels=[],
       yticklabels=[],
       zticklabels=[])

plt.show()


import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

np.random.seed(0)
t = np.linspace(0, 20, 300)
trend = 0.15*t + np.sin(t) + np.random.normal(0, 0.3, len(t))

x = np.random.randn(400)
y = 0.8*x + np.random.randn(400)/2

fig = plt.figure(figsize=(10, 6))
gs = GridSpec(2, 3, figure=fig, width_ratios=[1, 1, 0.35], height_ratios=[1, 1])

ax1 = fig.add_subplot(gs[0, :2])
ax1.plot(t, trend)
ax1.set_title("Trend")
ax1.set_xlabel("t")
ax1.set_ylabel("value")
ax1.grid(True)

ax2 = fig.add_subplot(gs[1, 0])
ax2.hist(x, bins=30)
ax2.set_title("Histogram")
ax2.set_xlabel("x")
ax2.set_ylabel("count")
ax2.grid(True)

ax3 = fig.add_subplot(gs[1, 1])
ax3.scatter(x, y, s=10)
ax3.set_title("Scatter")
ax3.set_xlabel("x")
ax3.set_ylabel("y")
ax3.grid(True)

ax4 = fig.add_subplot(gs[:, 2])
values = [np.mean(trend), np.std(trend)]
ax4.bar(["mean", "std"], values)
ax4.set_title("Indicator")
ax4.grid(True)

fig.suptitle("Dashboard with GridSpec", fontsize=14)

plt.tight_layout()
plt.show()


from matplotlib.animation import FuncAnimation
from IPython.display import HTML

x = np.linspace(0, 2*np.pi, 400)
y = np.sin(x)

fig, ax = plt.subplots()

ax.plot(x, y)

point, = ax.plot([], [], 'ro')

text = ax.text(0, 0, '')

ax.set_xlim(0, 2*np.pi)
ax.set_ylim(-1.2, 1.2)
ax.grid()

def init():
    point.set_data([], [])
    text.set_text('')
    return point, text

def update(frame):
    x_val = x[frame]
    y_val = y[frame]

    point.set_data([x_val], [y_val])

    text.set_position((x_val, y_val))
    text.set_text(f'x = {x_val:.2f}, y = {y_val:.2f}')

    return point, text

anim = FuncAnimation(
    fig,
    update,
    frames=len(x),
    init_func=init,
    interval=30,
    blit=True
)

HTML(anim.to_jshtml())
